<header id="page-header">
	<div class="header-inner container-large">
		{% render "logo", asLink: true %}
		<nav class="header-nav">
			<div>
				{% render "menu", location: 'header', title: title %}
				<div class="header-toggle-btns">
					<button hidden
						data-tooltip
						data-tooltip-message="Toggle theme"
						data-tooltip-position="bottom"
						class="js-toggle-btn toggle-theme">
						<span class="sr-only">Toggle theme</span>
						<svg class="theme-toggle-sun hvr-wobble-vertical">
							<use xlink:href="#sun"></use>
						</svg>
						<svg class="theme-toggle-moon hvr-wobble-vertical">
							<use xlink:href="#moon"></use>
						</svg>
					</button>
					<button hidden
						data-tooltip
						data-tooltip-message="Toggle animations"
						data-tooltip-position="bottom"
						class="js-toggle-btn toggle-anim">
						<span class="sr-only">Toggle animations</span>
						<svg class="anim-toggle-on hvr-wobble-vertical">
							<use xlink:href="#sparkles"></use>
						</svg>
						<svg class="anim-toggle-off hvr-wobble-vertical">
							<use xlink:href="#pause"></use>
						</svg>
					</button>
				</div>
			</div>
			{% render "page-header-bg-blob" %}
		</nav>
	</div>
</header>
