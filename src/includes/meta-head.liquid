{%- liquid
  if title
    assign title = title | append: ' | ' | append: site.author
  else
    assign title = site.author
  endif
  assign robots = meta.robots | default: 'index,follow'
  assign description = meta.description | default: site.description
-%}
<head>
  <meta charset="utf-8" />
  <title>
    {{- title -}}
  </title>
  <meta name="robots" content="{{ robots }}" />
  <meta name="revisit-after" content="1 days" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content="morkro" />
  <meta name="theme-color" content="#3652CF" />
  <meta name="color-scheme" content="light dark" />

    <!-- Meta data -->
  <meta name="author" content="{{ site.author }}" />
  {%- if keywords -%}
    <meta name="keywords" content="{{ keywords | join: ',' }}" />
  {%- endif -%}
  <meta name="description" content="{{ description }}" />
  <link rel="canonical" href="{{ page.url }}" />
  <link rel="shortcut icon" href="/assets/favicon.ico" />
  <link rel="author" href="/humans.txt" />
  <link
    rel="alternate"
    type="application/rss+xml"
    title="{{- title }} RSS"
    href="/feed.xml" />

  <!-- Open Graph data -->
  <meta property="og:title" content="{{ title }}" />
  <meta property="og:description" content="{{ description }}" />
  <meta property="og:image" content="{{ site.url }}/assets/img/moritz-mountains.webp" />
  <meta property="og:type" content="{% if pageClass == 'article' %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ page.url }}" />

  {% render "structured-data", structuredData: structuredData %}

  <!-- Stylesheets -->
  <link
    rel="stylesheet"
    type="text/css"
    href="/css/main.css?v={{ pkg.version }}-{{ site.timestamp }}" />
  {%- if pageClass -%}
    <link
      rel="stylesheet"
      type="text/css"
      href="/css/{{ pageClass }}.css?v={{ pkg.version }}-{{ site.timestamp }}" />
  {%- endif -%}

  <!-- Set preferences early to avoid FOUC -->
  <script>
    const $root = document.documentElement
    const readPreference = (key, query, onMatch, onMiss) => {
      const saved = localStorage.getItem(key)
      if (saved === onMatch || saved === onMiss) return saved
      return matchMedia(query).matches ? onMatch : onMiss
    }
    $root.dataset.theme = readPreference('morkro:theme', '(prefers-color-scheme: dark)', 'dark', 'light')
    $root.dataset.anim = readPreference('morkro:anim', '(prefers-reduced-motion: reduce)', 'off', 'on')
  </script>
</head>